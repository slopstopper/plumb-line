# Supply-chain guard: never run dependency lifecycle scripts
# (preinstall/install/postinstall). This removes the install-time vector the
# 2026 Shai-Hulud npm worm used to steal credentials and spread.
#
# Side effect: npm also skips this package's OWN pre/post hooks (e.g.
# prepublishOnly). Anything that must run before publish is therefore an
# explicit step in .github/workflows/release.yml, not a hook.
ignore-scripts=true
