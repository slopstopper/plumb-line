    },
    {
      "name": "a lineage step with no confidence counts as none against a minimum",
      "meta": { "provenanceVersion": 2, "source": "derived", "confidence": "none", "derivedFromMock": false, "lineage": [{ "id": "s1", "of": "input", "source": "real", "derivedFromMock": false }] },
      "options": { "minConfidence": "low" },
      "expectRefused": ["confidence: none is below the required low"]
    },
    {
      "name": "an unknown option is a programmer error, so a misspelt option cannot leave a check at its default",
      "meta": { "provenanceVersion": 2, "source": "mock", "confidence": "low", "derivedFromMock": true, "lineage": [] },
      "options": { "nomock": false },
      "expectError": "guard: unknown option nomock"
    },
    {
      "name": "a minimum confidence that is not a string is a programmer error",
      "meta": { "provenanceVersion": 2, "source": "real", "confidence": "high", "derivedFromMock": false, "lineage": [] },
      "options": { "minConfidence": 2 },
      "expectError": "guard: the minimum confidence must be one of none, low, medium, high"
    }
  ]
}
