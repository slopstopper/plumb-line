    { "name": "200 X-Cache HIT",            "status": 200, "headers": { "X-Cache": "HIT from edge" }, "fromCache": false, "expect": { "source": "real", "confidence": "medium" } },
    { "name": "200 X-Cache MISS",           "status": 200, "headers": { "X-Cache": "MISS" }, "fromCache": false, "expect": { "source": "real",        "confidence": "high" } },
    { "name": "200 Age=60.5 (fractional, still cached)", "status": 200, "headers": { "Age": "60.5" }, "fromCache": false, "expect": { "source": "real", "confidence": "medium" } },
    { "name": "200 Age=abc (malformed, ignored -> fresh)", "status": 200, "headers": { "Age": "abc" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=0x10 (hex is not decimal-seconds, ignored -> fresh) (#172: was JS 16 / Python raise)", "status": 200, "headers": { "Age": "0x10" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=1_000 (underscores are not decimal-seconds, ignored -> fresh) (#172: was JS NaN / Python 1000)", "status": 200, "headers": { "Age": "1_000" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=1e3 (scientific notation is not decimal-seconds, ignored -> fresh) (#172)", "status": 200, "headers": { "Age": "1e3" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=' 60 ' (surrounding whitespace tolerated, still cached) (#172)", "status": 200, "headers": { "Age": " 60 " }, "fromCache": false, "expect": { "source": "real", "confidence": "medium" } },
    { "name": "200 Age=\u0666\u0660 (non-ASCII digits are not decimal-seconds, ignored -> fresh) (#172: Python \\d is Unicode-aware, JS \\d is not)", "status": 200, "headers": { "Age": "\u0666\u0660" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=U+001C+60 (C0 separator is not OWS, ignored -> fresh) (#172 review: Python \\s matched it and float() then RAISED out of the tagger)", "status": 200, "headers": { "Age": "\u001c60" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=U+0085+60 (NEL is not OWS, ignored -> fresh) (#172 review: Python \\s matches it, JS \\s does not)", "status": 200, "headers": { "Age": "\u008560" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=U+FEFF+60 (BOM is not OWS, ignored -> fresh) (#172 review: JS \\s matches it, Python \\s does not, the divergence runs both ways)", "status": 200, "headers": { "Age": "\ufeff60" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=U+00A0+60 (NBSP is not OWS per RFC 7230, ignored -> fresh) (#172 review)", "status": 200, "headers": { "Age": "\u00a060" }, "fromCache": false, "expect": { "source": "real", "confidence": "high" } },
    { "name": "200 Age=HTAB+60 (HTAB IS OWS, still cached) (#172 review)", "status": 200, "headers": { "Age": "\t60" }, "fromCache": false, "expect": { "source": "real", "confidence": "medium" } },
    { "name": "200 fromCache flag",         "status": 200, "headers": {},                    "fromCache": true,  "expect": { "source": "real",        "confidence": "medium" } },
    { "name": "304 Not Modified",           "status": 304, "headers": {},                    "fromCache": false, "expect": { "source": "real",        "confidence": "medium" } },
    { "name": "404 Not Found",              "status": 404, "headers": {},                    "fromCache": false, "expect": { "source": "unavailable", "confidence": "none" } },
    { "name": "404 Age>0 (cache signals not consulted outside 2xx/304 — pins the api.md claim)", "status": 404, "headers": { "Age": "60" }, "fromCache": false, "expect": { "source": "unavailable", "confidence": "none" } },
    { "name": "500 Server Error",           "status": 500, "headers": {},                    "fromCache": false, "expect": { "source": "unavailable", "confidence": "none" } },
    { "name": "503 Unavailable",            "status": 503, "headers": {},                    "fromCache": false, "expect": { "source": "unavailable", "confidence": "none" } },
    { "name": "199 (below 2xx)",            "status": 199, "headers": {},                    "fromCache": false, "expect": { "source": "unavailable", "confidence": "none" } },
    { "name": "300 (3xx, not 304)",         "status": 300, "headers": {},                    "fromCache": false, "expect": { "source": "unavailable", "confidence": "none" } }
